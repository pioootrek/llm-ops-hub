{
  "build": {
    "releases_keep": 20
  },
  "paths": {
    "cache": "{root}/cache",
    "public": "{root}/public",
    "releases": "{root}/public_releases",
    "root": "~/.local/share/llm-ops-hub"
  },
  "projects": [
    {
      "backlog_dir": "docs/backlog",
      "backlog_ref": "main",
      "github_repo": "acme/example-project",
      "id": "example-project",
      "name": "Example Project",
      "repo_url": "git@github.com:acme/example-project.git"
    },
    {
      "backlog_dir": "docs/backlog",
      "backlog_ref": "main",
      "id": "infrastructure",
      "name": "Infrastructure",
      "repo_url": "git@github.com:acme/infrastructure.git"
    }
  ],
  "schema_version": 2,
  "server": {
    "host": "0.0.0.0",
    "port": 8080
  }
}
