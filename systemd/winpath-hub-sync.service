[Unit]
Description=Build WinPath LAN Hub static site
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pioootrek
Group=pioootrek
WorkingDirectory=/home/pioootrek/winpath-hub
ExecStart=/home/pioootrek/winpath-hub/bin/sync_hub.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/pioootrek/winpath-hub /home/pioootrek/.config/gh /home/pioootrek/.ssh
