[Unit]
Description=WinPath LAN Hub HTTP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pioootrek
Group=pioootrek
WorkingDirectory=/home/pioootrek/winpath-hub
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 0.0.0.0 --directory /home/pioootrek/winpath-hub/public
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/pioootrek/winpath-hub

[Install]
WantedBy=multi-user.target
